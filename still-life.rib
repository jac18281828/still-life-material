##
## still-life.rib -- a gold ball on a pedestal, a glass ball that lenses a
## potted prickly pear behind it, a mirror ball and a blue plastic torus on
## a marble floor before a clay wall. A warm disk overhead and a small blue
## sphere lamp light it; area lights glow only under the path tracer.
## Y is up; the camera looks down +z. `make` writes the textures and the
## cactus under build/ first:
##
##   make preview
##

Display "still-life.png" "file" "rgba"
Format 640 400 1
PixelSamples 2 2
Option "pathtracer" "integer samples" [64]
Projection "perspective" "fov" [28]
Clipping 0.5 50
Translate -0.02 0.3 5.6
Rotate -11 1 0 0
WorldBegin
Sides 2
AttributeBegin
	AreaLightSource "arealight" 1 "intensity" [22] "lightcolor" [1 0.92 0.8]
	Translate -2.2 2.6 -1.2
	Rotate -40 1 0 0
	Rotate 35 0 0 1
	Rotate -90 1 0 0
	Disk 0 1.2 360
AttributeEnd
AttributeBegin
	AreaLightSource "arealight" 2 "intensity" [70] "lightcolor" [0.6 0.75 1]
	Translate 2.8 1.2 -1.5
	Sphere 0.15 -0.15 0.15 360
AttributeEnd
## marble floor
AttributeBegin
	Surface "paintedplastic" "Kd" [0.9] "Ks" [0.25] "roughness" [0.04] "texturename" ["build/marble.tif"]
	Color [1 1 1]
	Polygon "P" [-4 -1 -5  4 -1 -5  4 -1 3  -4 -1 3] "st" [0 0  1 0  1 1  0 1]
AttributeEnd
## clay wall and skirting
AttributeBegin
	Surface "matte"
	Color [0.72 0.3 0.22]
	Polygon "P" [-10 -1 3  10 -1 3  10 8 3  -10 8 3]
	Surface "plastic" "Ks" [0.2] "roughness" [0.15]
	Color [0.88 0.84 0.76]
	Polygon "P" [-10 -1 2.95  10 -1 2.95  10 -0.82 2.95  -10 -0.82 2.95]
	Polygon "P" [-10 -0.82 2.95  10 -0.82 2.95  10 -0.82 3  -10 -0.82 3]
AttributeEnd
## pedestal and gold
AttributeBegin
	Surface "matte"
	Color [0.5 0.46 0.42]
	Translate -1.4 -1 0.75
	Rotate -90 1 0 0
	Cylinder 0.42 0 0.6 360
	Disk 0.6 0.42 360
AttributeEnd
AttributeBegin
	Surface "gilded" "roughness" [0.06] "texturename" ["build/foil.tif"] "float bump" [6]
	Color [0.95 0.76 0.48]
	Translate -1.4 0 0.75
	Rotate -90 0 1 0
	Rotate -90 1 0 0
	Sphere 0.4 -0.4 0.4 360
AttributeEnd
AttributeBegin
	Surface "glass"
	Translate -0.08 -0.5 -0.55
	Sphere 0.5 -0.5 0.5 360
AttributeEnd
AttributeBegin
	Surface "mirror" "Kr" [1]
	Translate 1.0 -0.7 0.3
	Sphere 0.3 -0.3 0.3 360
AttributeEnd
AttributeBegin
	Surface "plastic" "roughness" [0.1]
	Color [0.12 0.3 0.75]
	Translate 1.42 -0.6 -0.5
	Rotate 38 0 1 0
	Torus 0.3 0.1 0 360 360
AttributeEnd
## potted prickly pear
AttributeBegin
	Translate 0.48 -1 1.2
	Scale 1.6 1.6 1.6
	AttributeBegin
		Surface "plastic" "Ks" [0.1] "roughness" [0.3]
		Color [0.78 0.42 0.26]
		Rotate -90 1 0 0
		Hyperboloid 0.15 0 0  0.2 0 0.3 360
		Translate 0 0 0.3
		Torus 0.2 0.022 0 360 360
		Surface "matte"
		Color [0.18 0.12 0.08]
		Disk 0.005 0.19 360
	AttributeEnd
	ReadArchive "build/cactus.rib"
AttributeEnd
WorldEnd
