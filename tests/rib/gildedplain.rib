Display "build/check/gildedplain.png" "file" "rgba"
Format 160 100 1
PixelSamples 1 1
Option "pathtracer" "integer samples" [16]
Projection "perspective" "fov" [40]
Clipping 0.5 50
Translate 0 0 5
WorldBegin
Sides 2
LightSource "pointlight" 1 "from" [-2.5 2.5 -3] "intensity" [40]
AttributeBegin
	AreaLightSource "arealight" 2 "intensity" [12]
	Translate 2.5 2.5 -2.5
	Rotate 45 0 1 0
	Rotate 45 1 0 0
	Disk 0 1.5 360
AttributeEnd
AttributeBegin
	Surface "gilded" "Ka" [0.8] "Ks" [0.9] "roughness" [0.3]
	Color [0.95 0.76 0.48]
	Sphere 1 -1 1 360
AttributeEnd
WorldEnd
