## Marble floor: a checkerboard of cream and slate marble, and its tile normal map, generated into
## build/ by tools/marble.py. The polygon winds so its normal faces up.
AttributeBegin
	Attribute "identifier" "name" ["floor"]
	Surface "paintedplastic" "Kd" [0.9] "Ks" [0.25] "roughness" [0.04] "texturename" ["build/marble.tif"] "string normalname" ["build/marblenormal.tif"]
	Color [1 1 1]
	Polygon "P" [-4 -1 -5  -4 -1 3  4 -1 3  4 -1 -5] "st" [0 0  0 1  1 1  1 0]
AttributeEnd
